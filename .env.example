# ===== 必须配置 =====

# LLM API Keys（至少配置一个）
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== 安全配置 =====

# JWT 签名密钥（生产环境必须修改为随机字符串，长度 >= 16）
JWT_SECRET=change-this-to-a-random-secret-string
# JWT 过期时间（格式：数字+单位，如 7d、24h、60m）
JWT_EXPIRES_IN=7d
# 允许的前端来源（多个用逗号分隔）
# 本地开发: http://localhost:5173
# 生产部署: https://your-domain.com
# Electron: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ===== 可选配置 =====

# 服务端口（默认 8787，单机部署可不填）
OPENAI_PORT=8787
# 端口占用时最多重试次数
OPENAI_PORT_ATTEMPTS=10
# 启用流式传输详细日志（用于调试）
STREAM_VERBOSE=false
# 模型配置数据的主密钥（用于加密存储的 API Key，不设则用文件中的随机 Key）
# MODEL_CONFIG_MASTER_KEY=

