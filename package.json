{
  "name": "hi-web-talk",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "fetch:model-capabilities": "node scripts/fetchModelCapabilities.js",
    "build": "npm run fetch:model-capabilities && vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "pm2": "pm2 start ecosystem.config.cjs",
    "postinstall": "node scripts/patchTfmFonts.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:rebuild": "electron-builder install-app-deps",
    "electron": "electron .",
    "electron:dev": "cross-env HI_WEB_TALK_RENDERER_URL=http://localhost:5173 electron .",
    "electron:dev:full": "concurrently \"npm run dev\" \"npm run electron:dev\"",
    "electron:remote": "cross-env HI_WEB_TALK_MODE=remote HI_WEB_TALK_REMOTE_URL=http://127.0.0.1:8787 electron .",
    "electron:build": "npm run build && electron-builder",
    "android:deploy": "npm run build && npx cap copy && node scripts/deploy-android.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@choreruiz/capacitor-node-js": "^1.0.2",
    "@google/genai": "^1.52.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.18.1",
    "mammoth": "^1.12.0",
    "marked": "^17.0.6",
    "marked-highlight": "^2.2.4",
    "node-tikzjax": "^1.0.5",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1",
    "ws": "^8.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.hiwebtalk.desktop",
    "productName": "Hi Web Talk",
    "asar": true,
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "icon": "electron/icon-high-res.png",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "win": {
      "icon": "electron/icon-high-res.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
